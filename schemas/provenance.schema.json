{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "source",
              "parsed_document",
              "section",
              "block",
              "table",
              "cell",
              "chunk",
              "observation",
              "derived_value",
              "embedding",
              "context",
              "prompt_template",
              "model",
              "output",
              "claim",
              "dataset",
              "concept"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "sensitivity": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "observed_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          },
          "locator": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "selector": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "text"
                            ]
                          },
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "encoding": {
                            "enum": [
                              "unicode_codepoints"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "start",
                          "end",
                          "encoding"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "json"
                            ]
                          },
                          "pointer": {
                            "type": "string",
                            "pattern": "^(|/.*)$",
                            "maxLength": 2048
                          }
                        },
                        "required": [
                          "type",
                          "pointer"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "pdf"
                            ]
                          },
                          "page_no": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "bbox": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 4,
                            "maxItems": 4
                          },
                          "page_width": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "page_height": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "origin": {
                            "enum": [
                              "TOPLEFT",
                              "BOTTOMLEFT"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "page_no",
                          "bbox",
                          "page_width",
                          "page_height",
                          "origin"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "table"
                            ]
                          },
                          "table_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
                          },
                          "row": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "column": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "type",
                          "table_id",
                          "row",
                          "column"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "source_id",
                  "source_sha256",
                  "selector"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "ordinal": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "artifact_id",
          "revision",
          "kind",
          "sha256",
          "size_bytes",
          "media_type",
          "tenant_id",
          "sensitivity",
          "observed_at",
          "locator",
          "ordinal"
        ],
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "type": {
            "enum": [
              "part_of",
              "next",
              "derived_from",
              "supersedes",
              "references",
              "mentions",
              "supports",
              "refutes",
              "limits"
            ]
          },
          "status": {
            "enum": [
              "structural",
              "candidate",
              "reviewed"
            ]
          },
          "review_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "from",
          "to",
          "type",
          "status",
          "review_ref",
          "scope"
        ],
        "additionalProperties": false
      },
      "maxItems": 2048
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "kind": {
            "enum": [
              "person",
              "organization",
              "software"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "kind",
          "version"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "stage": {
            "enum": [
              "parse",
              "chunk",
              "normalize",
              "derive",
              "embed",
              "retrieve",
              "infer",
              "verify",
              "publish"
            ]
          },
          "status": {
            "enum": [
              "COMPLETE",
              "FAIL",
              "ABORT"
            ]
          },
          "started_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          },
          "ended_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "code_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parameters_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "job_id",
          "stage",
          "status",
          "started_at",
          "ended_at",
          "inputs",
          "outputs",
          "agents",
          "code_sha256",
          "parameters_sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 512
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "entities",
    "relations",
    "agents",
    "runs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trace:provenance:0.1.0",
  "title": "Opt-in TRACE provenance bundle; structure is not authorization"
}
